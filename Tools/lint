set -eu

ravel_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if ! command -v swiftlint >/dev/null 2>&1; then
    echo "SwiftLint is required. Install it with: brew install swiftlint" >&2
    exit 1
fi

cd "$ravel_root"
exec swiftlint lint --strict --no-cache "$@"
