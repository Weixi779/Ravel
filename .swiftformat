--min-version 0.61.0
--swift-version 6.2
--language-mode 6
--rules consecutiveBlankLines,indent,linebreakAtEndOfFile,linebreaks,spaceAroundOperators,trailingCommas,trailingSpace,wrapArguments,wrapAttributes

--indent 4
--linebreaks lf
--ifdef preserve
--ranges preserve

--wrap-arguments before-first
--wrap-parameters before-first
--allow-partial-wrapping false
--closing-paren balanced
--call-site-paren balanced
--wrap-collections disabled
--trailing-commas always

# Place type/function attributes above declarations; keep simple property attributes inline.
--type-attributes prev-line
--func-attributes prev-line
--stored-var-attributes same-line
--computed-var-attributes same-line
--complex-attributes prev-line

# Keep generated code, dependencies, and build outputs under their own tooling.
--exclude **/*.generated.swift,**/.build,**/.swiftpm,**/DerivedData,build,Backend/target,research
