    "historyPageSizeHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies when you refresh the history or open a repository. Previously loaded history stays visible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新历史或打开仓库时生效，已加载的历史会继续保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新整理歷史或開啟儲存庫時生效，已載入的歷史會繼續保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴の更新時、またはリポジトリを開いたときに適用されます。読み込み済みの履歴は引き続き表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록을 새로 고치거나 저장소를 열 때 적용됩니다. 이미 불러온 기록은 계속 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt beim Aktualisieren des Verlaufs oder Öffnen eines Repositorys. Bereits geladener Verlauf bleibt sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à l’actualisation de l’historique ou à l’ouverture d’un dépôt. L’historique déjà chargé reste visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica al actualizar el historial o abrir un repositorio. El historial ya cargado permanece visible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicado ao atualizar o histórico ou abrir um repositório. O histórico já carregado permanece visível."
          }
        }
      }
    },
