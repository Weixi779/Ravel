          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルの差分は大きすぎて表示できません。プレビューの上限は 2 MB または 20,000 行です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Diff dieser Datei ist zu groß. Die Vorschau ist auf 2 MB oder 20.000 Zeilen begrenzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
