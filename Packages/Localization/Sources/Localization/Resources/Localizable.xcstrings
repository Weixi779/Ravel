    "errorsDiffTooLarge": {
      "comment": "Preview size limit. Keep the limits consistent with FileDiff.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file's diff is too large to display. The preview limit is 2 MB or 20,000 lines."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件的差异过大，无法显示。预览上限为 2 MB 或 20,000 行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일의 차이가 너무 커서 표시할 수 없습니다. 미리보기 한도는 2 MB 또는 20,000줄입니다."
