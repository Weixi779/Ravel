    "errorsMalformedOutput": {
      "comment": "Argument is the one-based output record number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't decode revision %lld from jj. The repository has not been changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解析 jj 返回的第 %lld 条修订。仓库未被更改。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "jj에서 반환한 %lld번째 리비전을 해석할 수 없습니다. 저장소는 변경되지 않았습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解析 jj 傳回的第 %lld 筆修訂。儲存庫未被變更。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "jj が返した %lld 番目のリビジョンを解析できません。リポジトリは変更されていません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Revision %lld von jj konnte nicht gelesen werden. Das Repository wurde nicht verändert."
          }
        },
        "fr": {
