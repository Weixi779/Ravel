    "diffEmptyDetail": {
      "comment": "A merge revision is compared with the merge of all its parents.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This revision has the same contents as its merged parents."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此修订的内容与合并后的父修订相同。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 리비전의 내용은 부모 리비전을 병합한 내용과 같습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此修訂的內容與合併後的父修訂相同。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリビジョンの内容は、親リビジョンをマージした内容と同じです。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Revision hat denselben Inhalt wie ihre zusammengeführten Elternrevisionen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette révision a le même contenu que la fusion de ses révisions parentes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta revisión tiene el mismo contenido que la fusión de sus revisiones padre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta revisão tem o mesmo conteúdo que a mesclagem das revisões pai."
          }
        }
      }
    },
