{
  "sourceLanguage": "en",
  "strings": {
    "repositoryCommittedSyncFailure": {
      "comment": "Explain a local operation that committed before synchronization failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local operation committed. Synchronization failed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地操作已提交，同步失败。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 작업이 커밋되었지만 동기화에 실패했습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機操作已提交，同步失敗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル操作はコミットされましたが、同期に失敗しました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaler Vorgang gespeichert. Synchronisierung fehlgeschlagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opération locale enregistrée. Échec de la synchronisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Operación local confirmada. La sincronización ha fallado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Operação local registrada. Falha na sincronização."
          }
        }
      }
    },
