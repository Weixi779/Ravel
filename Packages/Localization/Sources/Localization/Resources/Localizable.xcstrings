      }
    },
    "errorsDuplicateCommit": {
      "comment": "Invalid structured log output.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "jj returned duplicate commit IDs. The log cannot be displayed reliably."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "jj 返回了重复的提交 ID，无法可靠地显示历史。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "jj가 중복된 커밋 ID를 반환했습니다. 기록을 올바르게 표시할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "jj 傳回了重複的提交 ID，無法可靠地顯示歷史。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "jj が重複したコミット ID を返しました。履歴を正しく表示できません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "jj hat doppelte Commit-IDs zurückgegeben. Der Verlauf kann nicht zuverlässig angezeigt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "jj a renvoyé des identifiants de commit en double. L’historique ne peut pas être affiché correctement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "jj devolvió identificadores de commit duplicados. El historial no se puede mostrar de forma fiable."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jj retornou IDs de commit duplicados. O histórico não pode ser exibido de forma confiável."
          }
        }
      }
    },
    "errorsExecutableNotFound": {
      "comment": "Recovery instruction when executable discovery fails.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel couldn't find jj. Install Jujutsu or choose your jj executable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel 找不到 jj。请安装 Jujutsu，或选择 jj 可执行文件。"
