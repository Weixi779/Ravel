    "historyRecordedStateHelp": {
      "comment": "Explain the read-only refresh contract.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh reads jj's recorded state without snapshotting your working directory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新只读取 jj 已记录的状态，不会为工作目录创建快照。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 고침은 작업 디렉터리의 스냅샷을 만들지 않고 jj에 기록된 상태만 읽습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新整理只會讀取 jj 已記錄的狀態，不會為工作目錄建立快照。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新では jj に記録された状態だけを読み取り、作業ディレクトリのスナップショットは作成しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktualisierung liest den von jj erfassten Stand, ohne einen Snapshot des Arbeitsverzeichnisses zu erstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’actualisation lit l’état enregistré par jj sans créer d’instantané de votre répertoire de travail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización lee el estado registrado por jj sin crear una instantánea del directorio de trabajo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização lê o estado registrado pelo jj sem criar um snapshot do diretório de trabalho."
          }
        }
      }
    },
