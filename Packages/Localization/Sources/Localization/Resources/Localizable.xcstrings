    "diffInheritedConflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conflict is inherited from the merged parents. There is no additional text change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此冲突继承自合并后的父版本，没有额外的文本变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此衝突繼承自合併後的父修訂，沒有額外的文字變更。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この競合は親リビジョンのマージ結果から引き継がれています。テキストに追加の変更はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 충돌은 부모 리비전을 병합한 결과에서 이어진 것입니다. 텍스트에 추가 변경 사항은 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Konflikt wurde von den zusammengeführten Elternrevisionen übernommen. Der Text wurde nicht weiter geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce conflit provient de la fusion des révisions parentes. Le texte n’a pas été modifié depuis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conflicto se ha heredado de la fusión de las revisiones padre. No hay cambios adicionales en el texto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conflito foi herdado da mesclagem das revisões pai. Não há alterações adicionais no texto."
          }
        }
      }
    },
