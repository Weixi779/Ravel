        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Diff konnte nicht vollständig gelesen werden. Aktualisiere den Verlauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce diff n’a pas pu être lu entièrement. Essayez d’actualiser l’historique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer estas diferencias por completo. Intenta actualizar el historial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler estas diferenças por completo. Tente atualizar o histórico."
          }
        }
      }
    },
